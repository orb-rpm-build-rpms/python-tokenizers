-	printf '$(PYO3_PATCH)' >> .cargo/config.toml
-	$(CARGO_ENV) cargo run --manifest-path ./tools/stub-gen/Cargo.toml; \
-	  status=$$?; cp .cargo/config.toml.bak .cargo/config.toml; rm -f .cargo/config.toml.bak; exit $$status
+	$(CARGO_ENV) cargo run --manifest-path ./tools/stub-gen/Cargo.toml
